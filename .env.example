# .env.example — copy to .env and fill in values as needed.
# AI_MODEL_CHAT controls which Spring AI model starter is active.
# Set to "openai" and provide OPENAI_API_KEY to enable the LLM client.
OPENAI_API_KEY=
AI_MODEL_CHAT=none

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 bytes)
# For production, generate a secure random 256-bit string (e.g. openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

