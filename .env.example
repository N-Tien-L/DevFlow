# .env.example — copy to .env and fill in values as needed.
# AI_MODEL_CHAT controls which Spring AI model starter is active.
# Set to "openai" and provide OPENAI_API_KEY to enable the LLM client.
OPENAI_API_KEY=
AI_MODEL_CHAT=none

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 bytes)
# For production, generate a secure random 256-bit string (e.g. openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Transactional email (T-004A). Defaults target the local Mailpit container (inbox: http://localhost:8025).
# Production: point at the provider's SMTP relay, e.g. Resend (smtp.resend.com:587, user "resend", password = API key).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=DevFlow <no-reply@devflow.local>

# Public URL of the web client, used to build email verification links.
FRONTEND_BASE_URL=http://localhost:3000

# Client IP resolution behind proxies: "native" trusts X-Forwarded-For only from internal proxy IPs.
FORWARD_HEADERS_STRATEGY=native

